// 低レイヤーライブラリのテスト

print("=== バイナリ操作 ===")
buf = bytes_new(16)
bytes_write(buf, 0, [0xDE, 0xAD, 0xBE, 0xEF])
bytes_write(buf, 4, [0x48, 0x65, 0x6C, 0x6C, 0x6F])
print(bytes_to_hex(buf))
print(bytes_dump(buf))

print("\n=== ビット操作 ===")
x = 0b11001010
print("元:     " + to_bin(x, 8))
print("AND 0F: " + to_bin(bit_and(x, 0x0F), 8))
print("OR  F0: " + to_bin(bit_or(x, 0xF0), 8))
print("XOR FF: " + to_bin(bit_xor(x, 0xFF), 8))
print("NOT:    " + to_bin(bit_not(x, 8), 8))
print("bit 3:  " + to_string(bit_get(x, 3)))
print("set 0:  " + to_bin(bit_set(x, 0), 8))
print("1の数:  " + to_string(bit_count(x)))
print("to_hex: " + to_hex(255, 4))

print("\n=== パック/アンパック ===")
packed = pack_u32(0xDEADBEEF)
print("pack u32: " + bytes_to_hex(packed))
print("unpack:   " + to_hex(unpack_u32(packed), 8))
packed16 = pack_u16(0x1234)
print("pack u16: " + bytes_to_hex(packed16))
print("unpack:   " + to_hex(unpack_u16(packed16), 4))

print("\n=== メモリ領域 ===")
mem = memory_new(256, 0x7C00, "BootSector")
mem.write_u8(0, 0xEB)
mem.write_u8(1, 0xFE)
mem.write_string(3, "SMILE")
print(mem)
print("offset 0: " + to_hex(mem.read_u8(0), 2))
print("offset 1: " + to_hex(mem.read_u8(1), 2))
print("string:   " + mem.read_string(3))
print(mem.dump(0, 32))

print("\n=== MBR操作 ===")
mbr = mbr_new()
print("ブートシグネチャ: " + to_string(mbr_check_signature(mbr)))
mbr_set_partition(mbr, 0, 0x80, 0x83, 2048, 1048576)
part = mbr_read_partition(mbr, 0)
print("パーティション0: " + to_string(part))
print(mbr.dump(446, 66))

print("\n=== アセンブラ ===")
code = asm_new(bits=16, base=0x7C00)
code.mov_ah(0x0E)
code.mov_al(0x41)
code.int_(0x10)
code.hlt()
print("生成バイト: " + bytes_to_hex(code.to_bytes()))
print(code.dump())
asm_mem = code.to_memory()
print(asm_mem)
print(asm_mem.dump())

print("\n=== ハードウェア情報 ===")
info = bios_info()
print("BIOS: " + to_string(info))

sys_info = system_info()
print("System: " + to_string(sys_info))

cpus = cpu_info_smbios()
print("CPU: " + to_string(cpus))

mem_devices = memory_info_smbios()
print("Memory: " + to_string(mem_devices))

print("\n=== ACPI ===")
tables = acpi_list_tables()
print("ACPIテーブル: " + to_string(tables))

print("\n=== PortIO (仮想) ===")
port = port_io_new()
port.set_virtual(0x3F8, 0x41)
val = port.read_u8(0x3F8)
print("port 0x3F8: " + to_hex(val, 2) + " ('" + to_string(chr(val)) + "')")
port.write_u8(0x3F8, 0x42)
print(port.dump_log())

print("\n=== 全テスト完了！ ===")
