// FizzBuzz - プログラミングの定番問題

function fizzbuzz(n) {
    for i in range_smile(1, n + 1) {
        if i % 15 == 0 {
            print("FizzBuzz")
        } else if i % 3 == 0 {
            print("Fizz")
        } else if i % 5 == 0 {
            print("Buzz")
        } else {
            print(to_string(i))
        }
    }
}

print("=== FizzBuzz (1〜30) ===")
fizzbuzz(30)
