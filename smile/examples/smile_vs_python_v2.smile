print("\n============================================================")
print("  総合比較 (15項目)")
print("============================================================")

headers2 = ["項目", "Smile", "Python", "勝者"]
rows2 = [
    ["標準関数数", "140+", "~60", "Smile >>>"],
    ["DB操作", "3行", "6行+import", "Smile >>"],
    ["UUID", "uuid4()", "import uuid", "Smile >"],
    ["並列処理", "thread_map()", "6行", "Smile >>"],
    ["統計関数", "標準", "import", "Smile >>"],
    ["圧縮", "compress()", "import zlib", "Smile >"],
    ["テーブル表示", "table()", "pip install", "Smile >>"],
    ["デコレータ", "cache/retry標準", "import", "Smile >"],
    ["バリデーション", "is_email()標準", "pip install", "Smile >>"],
    ["セキュリティ", "標準", "3 import", "Smile >"],
    ["ホットリロード", "smile watch", "なし", "Smile >>>"],
    ["キャッシュ", "メモリ+ディスク", "ディスクのみ", "Smile >>"],
    ["エラーメッセージ", "日本語+提案", "英語のみ", "Smile >>>"],
    ["パッケージ管理", "自動DL+削除", "pip必須", "Smile >>>"],
    ["GPU", "標準", "CuPy 500MB+", "Smile >>>"],
]
print(table(headers2, rows2))

smile_wins = 15
python_wins = 0
